/* Cloudflare Workers code runs in workerd, not in a browser or Node: it gets the runtime's own
   types (generated by `wrangler types` into worker-configuration.d.ts) and no DOM. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts", "./admin/worker-configuration.d.ts"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["workers/**/*.ts", "worker-configuration.d.ts", "admin/worker-configuration.d.ts"]
}
