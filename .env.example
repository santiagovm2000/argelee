# Copy to `.env` (git-ignored) and fill in. CI supplies the same names from its own settings.

# PrimeUI / PrimeNG Community licence key.
# Note: this ends up in the browser bundle verbatim — minification is not encryption.
# Keeping it here only keeps it out of the public repo, which is what matters.
PRIMENG_LICENSE_KEY=

# Absolute origin used for canonical, hreflang and sitemap URLs. Include any
# subpath (GitHub Pages project sites live at https://<user>.github.io/<repo>).
# Defaults to http://localhost:4200.
SITE_ORIGIN=

# Set to `false` on preview deployments: emits `noindex, nofollow` and a
# `Disallow: /` robots.txt so the preview never competes with the real domain.
SITE_INDEXABLE=
