# Copy to `.env` (git-ignored) and fill in. CI supplies the same names from its own settings.

# Production (Cloudflare Workers): SITE_ORIGIN=https://argelees.com and SITE_INDEXABLE=true.

# Absolute origin used for canonical, hreflang, og:image and sitemap URLs, including any
# subpath if the site is ever served under one.
# Defaults to http://localhost:4200.
SITE_ORIGIN=

# Set to `false` on preview deployments: emits `noindex, nofollow` and a
# `Disallow: /` robots.txt so the preview never competes with the real domain.
SITE_INDEXABLE=
