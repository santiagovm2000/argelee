# Copy to `.env` (git-ignored) and fill in. CI supplies the same names from its own settings.

# Production (Cloudflare Workers): SITE_ORIGIN=https://argelees.com and SITE_INDEXABLE=true.

# Absolute origin used for canonical, og:image and sitemap URLs, including any
# subpath if the site is ever served under one.
# Defaults to http://localhost:4200.
SITE_ORIGIN=

# Set to `false` on preview deployments: emits `noindex, nofollow` and a
# `Disallow: /` robots.txt so the preview never competes with the real domain.
SITE_INDEXABLE=

# Set to `true` where Cloudflare's image transformations are enabled for the zone
# (production). Off, uploaded photos are served as the original file.
SITE_IMAGE_TRANSFORMS=

# Where `bun run catalog:pull` reads the catalogue snapshot from: `remote` (the account's KV,
# the default) or `local` (the `wrangler dev` state seeded with `bun run catalog:seed --local`).
CATALOG_SOURCE=
